<mxfile host="drawio" version="24.0.0">
  <diagram id="routes" name="Cluster deployment routes">
    <mxGraphModel dx="1400" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Part 4: two routes to the same cluster deployment" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="36" as="geometry" />
        </mxCell>

        <mxCell id="start" value="&lt;b&gt;Start&lt;/b&gt;&lt;br&gt;Part 3 complete: network, switches, Active Directory prepared (OU and LCM user), Azure prerequisites" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="500" y="70" width="400" height="70" as="geometry" />
        </mxCell>

        <mxCell id="p01" value="&lt;b&gt;Phase 01: Hardware provisioning&lt;/b&gt;&lt;br&gt;BIOS and NIC settings, firmware at the OEM support-matrix level, BMC, DHCP reservations. Same on both routes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="500" y="170" width="400" height="70" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="How is the OS installed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="270" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="isoLabel" value="ISO or OEM image (GA)" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#1f4e79;" vertex="1" parent="1">
          <mxGeometry x="90" y="380" width="380" height="30" as="geometry" />
        </mxCell>
        <mxCell id="smpLabel" value="Simplified machine provisioning (preview)" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#7f6000;" vertex="1" parent="1">
          <mxGeometry x="840" y="380" width="480" height="30" as="geometry" />
        </mxCell>

        <mxCell id="iso02" value="&lt;b&gt;Phase 02: Install from ISO&lt;/b&gt;&lt;br&gt;Install wizard on each machine over the BMC console. OEM image may include drivers and C:\SBE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="90" y="420" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="iso03" value="&lt;b&gt;Phase 03: OS configuration, all tasks&lt;/b&gt;&lt;br&gt;WinRM, drivers and SBE, static IP, one gateway, DNS, time, host name, clean data drives. RDP and ICMP optional" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="90" y="530" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="iso04" value="&lt;b&gt;Phase 04: Arc registration&lt;/b&gt;&lt;br&gt;Register each machine. Arc machine is named after the host" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="90" y="650" width="380" height="70" as="geometry" />
        </mxCell>

        <mxCell id="smp02" value="&lt;b&gt;Phase 02: Simplified provisioning&lt;/b&gt;&lt;br&gt;Maintenance environment, voucher, claim in Azure. Microsoft installs the OS, sets the host name, connects Arc and installs the mandatory extensions. Arc machine is named &amp;lt;device-id&amp;gt;-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="880" y="420" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Automated with&lt;br&gt;azurelocal-ztp?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="975" y="545" width="210" height="95" as="geometry" />
        </mxCell>
        <mxCell id="ztp" value="&lt;b&gt;ZTP Prepare stage&lt;/b&gt;&lt;br&gt;OEM network drivers and C:\SBE from the SBE, static IP, one gateway, DNS, time, deployment admin. Checked before ready for Validate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1080" y="670" width="290" height="110" as="geometry" />
        </mxCell>
        <mxCell id="smp03" value="&lt;b&gt;Simplified Task 06: Prepare for Validate&lt;/b&gt;&lt;br&gt;By hand: OEM drivers, C:\SBE, static IP, one gateway, DNS, time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="790" y="670" width="270" height="110" as="geometry" />
        </mxCell>
        <mxCell id="skip04" value="&lt;b&gt;Skip Phase 04&lt;/b&gt;&lt;br&gt;Already registered with Arc by provisioning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="810" width="360" height="60" as="geometry" />
        </mxCell>

        <mxCell id="p05" value="&lt;b&gt;Phase 05: Cluster deployment&lt;/b&gt;&lt;br&gt;Portal or ARM template. Validate, then Deploy, with the Arc machine resource IDs from Azure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="500" y="920" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p06" value="&lt;b&gt;Phase 06: Post-deployment&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="500" y="1030" width="400" height="50" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Before Validate, check Microsoft Learn and your OEM's deployment guide for the OS settings your build and hardware need" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="910" width="330" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="start" target="p01"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="p01" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="ISO / OEM image" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;" edge="1" parent="1" source="d1" target="iso02"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="320" /></Array></mxGeometry></mxCell>
        <mxCell id="e4" value="Simplified provisioning" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;" edge="1" parent="1" source="d1" target="smp02"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="320" /></Array></mxGeometry></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="iso02" target="iso03"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="iso03" target="iso04"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="smp02" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;" edge="1" parent="1" source="d2" target="ztp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1225" y="592" /></Array></mxGeometry></mxCell>
        <mxCell id="e9" value="No, portal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;" edge="1" parent="1" source="d2" target="smp03"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="925" y="592" /></Array></mxGeometry></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="smp03" target="skip04"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="ztp" target="skip04"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="iso04" target="p05"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="880" /><mxPoint x="700" y="880" /></Array></mxGeometry></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="skip04" target="p05"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="890" /><mxPoint x="700" y="890" /></Array></mxGeometry></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="p05" target="p06"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
