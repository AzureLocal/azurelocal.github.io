<mxfile host="drawio"><diagram id="provisioning-to-os-configuration" name="Provisioning method to OS configuration"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t1" value="Which provisioning method, then OS configuration: from the OS install to ARM Deploy" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1300" height="36" as="geometry"/></mxCell>
<mxCell id="start" value="&lt;b&gt;Start: Phase 01 done&lt;/b&gt;&lt;br&gt;Hardware, BMC, BIOS and firmware at the OEM support-matrix level, DHCP reservations. The master infrastructure.yml is filled in: scenario.os_install, the nodes and their ports by MAC, the network, identity, hardware.sbe." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="480" y="70" width="440" height="76" as="geometry"/></mxCell>
<mxCell id="d1" value="&lt;b&gt;How is the OS installed?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="176" width="280" height="110" as="geometry"/></mxCell>
<mxCell id="iso" value="&lt;b&gt;Manual ISO install (Phase 02, manual installation)&lt;/b&gt;&lt;br&gt;Install from the Microsoft ISO or your OEM image on every node, through the BMC console (iDRAC virtual media).&lt;br&gt;There is no unattended ISO install for Azure Local: a person does it on each node, so OS configuration always starts after the OS install.&lt;br&gt;Set scenario.os_install: iso. The Arc machine does not exist yet." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="540" height="150" as="geometry"/></mxCell>
<mxCell id="smp" value="&lt;b&gt;Simplified provisioning (preview): azurelocal-ztp, or the portal tasks&lt;/b&gt;&lt;br&gt;Azure installs the OS and registers each machine with Arc. ZTP does it with no one in the rack and ends at the Handoff: Provisioned, Arc-connected, BIOS restored, management address verified (Mode A) or left to OS configuration (Modes B and C).&lt;br&gt;Set scenario.os_install: simplified. The Arc machine is named &amp;lt;device-id&amp;gt;-1." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="800" y="330" width="540" height="150" as="geometry"/></mxCell>
<mxCell id="detect" value="&lt;b&gt;Method detection (per node, first step of the automated run)&lt;/b&gt;&lt;br&gt;Declared: scenario.os_install in the master file, iso or simplified.&lt;br&gt;Checked against evidence:&lt;br&gt;  - the ZTP handoff file is present and lists the node&lt;br&gt;  - the Arc machine exists and is Connected&lt;br&gt;  - the node answers (WinRM) on its management address&lt;br&gt;Declared and evidence agree: that node takes its path.&lt;br&gt;They disagree: the run reports it for that node, with what it saw, instead of guessing. Fix the file or the node, then run again." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="530" width="520" height="190" as="geometry"/></mxCell>
<mxCell id="pathZ" value="&lt;b&gt;Simplified path: over Azure Arc Run Command&lt;/b&gt;&lt;br&gt;Transport: HTTPS to Azure only. No path to the nodes' management subnet.&lt;br&gt;1. Verify what ZTP did: Provisioned, Arc Connected, the management address result by mode, BIOS restored (from the handoff and a read of the node).&lt;br&gt;2. Do the rest, only where the node differs from the file:&lt;br&gt;  - the static management address by MAC (Modes B and C), before any other port loses DHCP&lt;br&gt;  - DHCP and extra default gateways off on the other ports; unused ports disabled&lt;br&gt;  - OEM network drivers from the SBE in C:\SBE&lt;br&gt;  - DNS, time, deployment administrator, MPIO and SAN checks&lt;br&gt;  - leftover local storage, if os_configuration.clear_storage is true" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="800" y="790" width="540" height="230" as="geometry"/></mxCell>
<mxCell id="pathI" value="&lt;b&gt;ISO path: over WinRM with the vault local admin&lt;/b&gt;&lt;br&gt;Transport: WinRM from a host that reaches the nodes' management subnet (TCP 5985), signed in with the local administrator from Key Vault.&lt;br&gt;1. Prepare the node: the computer name, the static management address by MAC, WinRM, RDP and ICMP.&lt;br&gt;2. Register the node with Azure Arc (the ISO route has no Arc machine yet).&lt;br&gt;3. Do the same rest as the other path, only where the node differs from the file:&lt;br&gt;  - DHCP and extra default gateways off on the other ports; unused ports disabled&lt;br&gt;  - OEM network drivers from the SBE, unless the OEM image has them&lt;br&gt;  - DNS, time, deployment administrator, MPIO and SAN checks&lt;br&gt;  - leftover local storage, if os_configuration.clear_storage is true" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="790" width="540" height="230" as="geometry"/></mxCell>
<mxCell id="conv" value="&lt;b&gt;Converge check (verification pass)&lt;/b&gt;&lt;br&gt;Every node is read again and matches infrastructure.yml: nothing left to change, nothing Blocked. A re-run on a converged node changes nothing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="440" y="1070" width="520" height="96" as="geometry"/></mxCell>
<mxCell id="fail" value="&lt;b&gt;Not converged or Blocked&lt;/b&gt;&lt;br&gt;The run ends with a non-zero exit code and the report names the node, the step and the reason. Fix it and run again: the run is safe to repeat." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="1010" y="1070" width="330" height="96" as="geometry"/></mxCell>
<mxCell id="val" value="&lt;b&gt;Phase 05: ARM Validate&lt;/b&gt;&lt;br&gt;New-AzureLocalArmParameters, then Validate. Read the validation steps. Never deploys." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="480" y="1220" width="440" height="66" as="geometry"/></mxCell>
<mxCell id="dep" value="&lt;b&gt;Phase 05: ARM Deploy&lt;/b&gt;&lt;br&gt;A separate, explicit run. Needs a successful Validate." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="480" y="1316" width="440" height="66" as="geometry"/></mxCell>
<mxCell id="post" value="&lt;b&gt;Phase 06: post-deployment&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="480" y="1412" width="440" height="50" as="geometry"/></mxCell>
<mxCell id="adn" value="&lt;b&gt;Before Validate&lt;/b&gt;&lt;br&gt;Active Directory prepared (OU and LCM user), or local identity. Azure resource providers registered. Arc machines Connected. The OS configuration report feeds the ARM parameters." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="60" y="1220" width="340" height="100" as="geometry"/></mxCell>
<mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="start" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e3" value="ISO or OEM image" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="iso"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e4" value="Simplified provisioning" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1" target="smp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e5" value="OS installed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="iso" target="detect"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e6" value="Handoff written" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="smp" target="detect"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e7" value="iso" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="detect" target="pathI"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e8" value="simplified" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="detect" target="pathZ"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e9" value="plan, approval, apply" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pathI" target="conv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e10" value="plan, approval, apply" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pathZ" target="conv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e11" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="conv" target="fail"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e12" value="gate: all nodes converged" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="conv" target="val"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e13" value="gate: Validate succeeded" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="val" target="dep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="dep" target="post"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
</root></mxGraphModel></diagram></mxfile>
