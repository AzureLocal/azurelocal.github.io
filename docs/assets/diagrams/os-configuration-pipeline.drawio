<mxfile host="drawio"><diagram id="os-configuration-pipeline" name="OS configuration pipeline"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="660" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t1" value="OS configuration from a pipeline: plan job, manual approval, apply job, report artifact" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="36" as="geometry"/></mxCell>
<mxCell id="p1" value="&lt;b&gt;1. Trigger&lt;/b&gt;&lt;br&gt;A manual run (GitHub workflow_dispatch, GitLab web pipeline) or a merge to the branch that holds infrastructure.yml.&lt;br&gt;Inputs: the nodes to run (default every node) and, optionally, one step.&lt;br&gt;The master file comes from the repository or the runner; it holds Key Vault references only, never a secret." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="270" height="190" as="geometry"/></mxCell>
<mxCell id="p2" value="&lt;b&gt;2. Plan job (read-only)&lt;/b&gt;&lt;br&gt;Signs in with the runner's identity: a managed identity or an OIDC federated credential, no stored secret.&lt;br&gt;Runs the OS configuration run in Plan mode: method detection, one read per node, the comparison.&lt;br&gt;Prints the plan table and uploads it with the JSON report as an artifact. Changes nothing on any node." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="330" y="70" width="270" height="190" as="geometry"/></mxCell>
<mxCell id="p3" value="&lt;b&gt;3. Manual approval&lt;/b&gt;&lt;br&gt;A named reviewer reads the plan artifact and approves. It lists every change per node, and with os_configuration.clear_storage the disks that would be wiped.&lt;br&gt;GitHub: an environment with required reviewers. GitLab: a manual job in a protected environment.&lt;br&gt;No approval, no apply." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="640" y="70" width="270" height="190" as="geometry"/></mxCell>
<mxCell id="p4" value="&lt;b&gt;4. Apply job&lt;/b&gt;&lt;br&gt;Same commit, same file, same inputs as the plan.&lt;br&gt;Runs Apply: only the Change items, restarts where needed, a verification pass until each node matches. Re-running is safe.&lt;br&gt;A node that fails is reported and the other nodes still run." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="950" y="70" width="270" height="190" as="geometry"/></mxCell>
<mxCell id="p5" value="&lt;b&gt;5. Report artifact and exit code&lt;/b&gt;&lt;br&gt;The JSON report (no secrets): changes, plan, ports by MAC with OS names, SAN disks.&lt;br&gt;Exit 0: every node matches the file. Non-zero: a Blocked item or a node not converged, and the job fails.&lt;br&gt;Only a green job lets the ARM Validate stage start." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1260" y="70" width="270" height="190" as="geometry"/></mxCell>
<mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="gh" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;on: workflow_dispatch with inputs nodes and step.&lt;br&gt;jobs.plan: runs-on a runner with PowerShell 7; steps: checkout, azure/login (OIDC), run the wrapper in Plan mode, actions/upload-artifact (plan table and report).&lt;br&gt;jobs.apply: needs: plan; environment: os-configuration-approval (required reviewers); steps: checkout, azure/login, run the wrapper in Apply mode, actions/upload-artifact (report).&lt;br&gt;A job fails when the script exits non-zero, which stops any later job that needs it." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="310" width="750" height="150" as="geometry"/></mxCell>
<mxCell id="gl" value="&lt;b&gt;GitLab CI&lt;/b&gt;&lt;br&gt;stages: plan, apply.&lt;br&gt;plan: script runs the wrapper in Plan mode; artifacts: paths (plan table, report), expire_in a few days, when: always.&lt;br&gt;apply: needs: [plan]; when: manual with allow_failure: false; environment: os-configuration (protected, with approvers); script runs the wrapper in Apply mode; artifacts: paths (report).&lt;br&gt;Id tokens (OIDC) or the runner's managed identity sign in to Azure; nothing is stored in CI variables except non-secret names." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="790" y="310" width="740" height="150" as="geometry"/></mxCell>
<mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="gh"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="gl"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="465" y="285"/><mxPoint x="1160" y="285"/></Array></mxGeometry></mxCell>
<mxCell id="r1" value="&lt;b&gt;What the runner needs&lt;/b&gt;&lt;br&gt;PowerShell 7 and Az.Accounts. A Linux runner is enough for the default Arc transport: the call goes to Azure over HTTPS (443) and the Connected Machine agent on each node does the rest, so the runner needs no path to the nodes' management subnet. For the WinRM path (the ISO route) the runner must reach TCP 5985 on the nodes; check that from the runner before relying on it." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="500" height="130" as="geometry"/></mxCell>
<mxCell id="r2" value="&lt;b&gt;Identity and roles (resource group scope, no subscription role)&lt;/b&gt;&lt;br&gt;Azure Connected Machine Resource Administrator and Reader on the Arc machines' resource group; Key Vault Secrets User on the vault that holds the local administrator password; Storage roles only if a staging account is used. Protected values travel as protected parameters and never reach the report or the log." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="540" y="500" width="500" height="130" as="geometry"/></mxCell>
<mxCell id="r3" value="&lt;b&gt;Gates&lt;/b&gt;&lt;br&gt;The plan job is the review. The approval is the gate. The apply job never runs on its own, and a non-zero exit stops the pipeline before ARM Validate. Keep the plan and the apply on the same commit so the person approves what runs." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="1060" y="500" width="470" height="130" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
