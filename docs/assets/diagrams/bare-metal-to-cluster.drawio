<mxfile host="drawio"><diagram id="bare-metal-to-cluster" name="Bare metal to a deployed cluster"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1320" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t1" value="Part 4, end to end: from bare metal to a deployed Azure Local cluster" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1450" height="36" as="geometry"/></mxCell>
<UserObject label="&lt;b&gt;Phase 01: Hardware and iDRAC&lt;/b&gt;&lt;br&gt;Racked and cabled. BMC address and login, BIOS and NIC settings, firmware at the OEM support-matrix level, DHCP reservations for the management MACs. The same for every route. The master infrastructure.yml starts here." link="https://azurelocal.cloud/docs/implementation/04-cluster-deployment/phase-01-hardware-provisioning/" id="p01"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="450" y="60" width="600" height="96" as="geometry"/></mxCell></UserObject>
<mxCell id="dec" value="&lt;b&gt;How is the OS installed?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="190" width="280" height="100" as="geometry"/></mxCell>
<UserObject label="&lt;b&gt;Phase 02: manual ISO install (GA)&lt;/b&gt;&lt;br&gt;Dell BOSS virtual disk, the OEM image or Microsoft ISO mounted through iDRAC virtual media, the install wizard on every node. A person does this on each node: there is no unattended ISO install for Azure Local.&lt;br&gt;No Arc machine yet. scenario.os_install: iso." link="https://azurelocal.cloud/docs/implementation/04-cluster-deployment/phase-02-os-installation/manual-installation/" id="iso"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="560" height="170" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;Phase 02: simplified provisioning (preview), azurelocal-ztp&lt;/b&gt;&lt;br&gt;One command from a Windows management host or a pipeline: Boot, Bootstrap, Vouchers, Device, Azure claim, Ready, Network (verify-only), Restore, Handoff.&lt;br&gt;Azure installs the OS and registers each machine with Arc. FC cards can be off during the install and are restored afterwards. Ends at the Handoff: Provisioned and Arc-connected. Or do it in the portal (tasks 1 to 5).&lt;br&gt;scenario.os_install: simplified." link="https://azurelocal.cloud/docs/implementation/04-cluster-deployment/phase-02-os-installation/simplified-provisioning/automation/" id="ztp"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="880" y="330" width="560" height="220" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;Phase 03: OS configuration (the toolkit)&lt;/b&gt;&lt;br&gt;Automated run (preferred): Invoke-AzureLocalOsConfiguration, one run for the whole cluster, standalone or from a GitHub or GitLab pipeline. Method detection per node, then plan, approval gate, apply, verification pass.&lt;br&gt;Simplified path: over Arc Run Command, verify what ZTP did and do the rest. ISO path: over WinRM with the vault local admin, computer name, static management address by MAC, Arc registration.&lt;br&gt;Both: OEM drivers and the SBE, DHCP and extra gateways off, DNS, time, host name, local administrator, MPIO and SAN checks, optional storage wipe.&lt;br&gt;Or the 16 manual tasks in the same phase.&lt;br&gt;Result: every node matches infrastructure.yml, and a report." link="https://azurelocal.cloud/docs/implementation/04-cluster-deployment/phase-03-os-configuration/automated-os-configuration" id="osc"><mxCell style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="610" width="860" height="210" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;Phase 04: Arc registration (ISO route)&lt;/b&gt;&lt;br&gt;Registers each machine with Azure Arc, named after the host. The simplified route skips it: provisioning already registered the machines (named &amp;lt;device-id&amp;gt;-1)." link="https://azurelocal.cloud/docs/implementation/04-cluster-deployment/phase-04-arc-registration/" id="p04"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="880" width="560" height="110" as="geometry"/></mxCell></UserObject>
<mxCell id="ad" value="&lt;b&gt;Before Validate&lt;/b&gt;&lt;br&gt;Active Directory prepared (OU and LCM user, Part 3), or local identity. Azure resource providers registered. Every Arc machine Connected. Use each machine's arcMachineResourceId from the handoff on the simplified route." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="1200" y="880" width="280" height="140" as="geometry"/></mxCell>
<UserObject label="&lt;b&gt;Phase 05: ARM Validate&lt;/b&gt;&lt;br&gt;New-AzureLocalArmParameters reads the OS configuration report; Validate never deploys. Read every validation step." link="https://azurelocal.cloud/docs/implementation/04-cluster-deployment/phase-05-cluster-deployment/" id="val"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="460" y="1050" width="580" height="70" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;Phase 05: ARM Deploy&lt;/b&gt;&lt;br&gt;A separate, explicit run. Needs a successful Validate." link="https://azurelocal.cloud/docs/implementation/04-cluster-deployment/phase-05-cluster-deployment/" id="dep"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="460" y="1150" width="580" height="60" as="geometry"/></mxCell></UserObject>
<UserObject label="&lt;b&gt;Phase 06: post-deployment&lt;/b&gt;" link="https://azurelocal.cloud/docs/implementation/04-cluster-deployment/phase-06-post-deployment/" id="post"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="460" y="1240" width="580" height="50" as="geometry"/></mxCell></UserObject>
<mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="p01" target="dec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e3" value="ISO or OEM image" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec" target="iso"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e4" value="Simplified provisioning" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec" target="ztp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e5" value="OS installed, no Arc machine" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="iso" target="osc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e6" value="ztp-handoff.json" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ztp" target="osc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e7" value="ISO route" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="osc" target="p04"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p04" target="val"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="340" y="1085"/></Array></mxGeometry></mxCell>
<mxCell id="e9" value="simplified route: no Phase 04" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="osc" target="val"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1094" y="1085"/></Array></mxGeometry></mxCell>
<mxCell id="e10" value="gate: Validate succeeded" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="val" target="dep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
