<mxfile host="drawio"><diagram id="os-configuration-flow" name="OS configuration flow"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2420" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t1" value="Automated OS configuration: every step, in the order it runs, for one node and for the run" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="36" as="geometry"/></mxCell>
<mxCell id="s1" value="&lt;b&gt;1. Plan (read-only)&lt;/b&gt;&lt;br&gt;Reads each node, compares it with infrastructure.yml, prints what would change and writes the report. Nothing on a node changes. Safe to run at any time." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="340" height="80" as="geometry"/></mxCell>
<mxCell id="s2" value="&lt;b&gt;2. Approval gate&lt;/b&gt;&lt;br&gt;A person reads the plan. In a pipeline this is a manual approval in front of the apply job." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="420" y="60" width="340" height="80" as="geometry"/></mxCell>
<mxCell id="s3" value="&lt;b&gt;3. Apply&lt;/b&gt;&lt;br&gt;Changes only the items marked Change, restarts where needed, reads again and repeats until the node matches." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="820" y="60" width="340" height="80" as="geometry"/></mxCell>
<mxCell id="s4" value="&lt;b&gt;4. Verify&lt;/b&gt;&lt;br&gt;A last read of every node: nothing left to change and nothing Blocked. The report and the exit code say so." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1220" y="60" width="340" height="80" as="geometry"/></mxCell>
<mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t5" value="Once per run" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="160" width="600" height="24" as="geometry"/></mxCell>
<mxCell id="a" value="&lt;b&gt;Inputs&lt;/b&gt;&lt;br&gt;infrastructure.yml, the master file (schema 5).&lt;br&gt;ztp-handoff.json, when ZTP ran (optional).&lt;br&gt;An Az sign-in (Connect-AzAccount) and Key Vault read, for the local administrator password.&lt;br&gt;No secret is written to a file, the report or the log." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="190" width="340" height="150" as="geometry"/></mxCell>
<mxCell id="b" value="&lt;b&gt;Validate and build each node's spec&lt;/b&gt;&lt;br&gt;Schema 5 rules on the file: stop if it fails.&lt;br&gt;The SBE package hash is checked against the OEM manifest before any node is touched: a mismatch stops the run.&lt;br&gt;Each node's spec: ports by MAC, management mode, SAN design, local admin." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="420" y="190" width="340" height="150" as="geometry"/></mxCell>
<mxCell id="c" value="&lt;b&gt;Method and transport&lt;/b&gt;&lt;br&gt;Method detection per node: scenario.os_install checked against the evidence (handoff, Arc machine, reachability).&lt;br&gt;Transport: Azure Arc Run Command when every node has a Connected Arc machine (HTTPS to Azure only); otherwise WinRM with the vault local admin." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="820" y="190" width="340" height="150" as="geometry"/></mxCell>
<mxCell id="d" value="&lt;b&gt;Spec only (-SpecOnly)&lt;/b&gt;&lt;br&gt;Prints what each node should look like from the files alone. Touches no node, no Azure resource and no Key Vault. Use it to check the file before the first plan." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1220" y="190" width="340" height="150" as="geometry"/></mxCell>
<mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="frame" value="For each node" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="375" width="1560" height="1700" as="geometry"/></mxCell>
<mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c" target="read"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="360"/><mxPoint x="250" y="360"/></Array></mxGeometry></mxCell>
<mxCell id="read" value="&lt;b&gt;Read (one read-only script per node)&lt;/b&gt;&lt;br&gt;Gathers the whole state in one call: WinRM, RDP and ICMP, ports by MAC with their OS names, drivers, DNS, time, computer name, the local administrator, MPIO and SAN disks, local storage, the files in C:\SBE.&lt;br&gt;Over Arc: a transient Run Command resource, created and deleted for each call." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="420" height="120" as="geometry"/></mxCell>
<mxCell id="cmp" value="&lt;b&gt;Compare (pure: no node is touched)&lt;/b&gt;&lt;br&gt;Every step turns the state into items: Ok, Change, Blocked, Info or Skipped. Only Change items are ever applied. Blocked items are things this tool will not fix." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="420" height="100" as="geometry"/></mxCell>
<mxCell id="dec1" value="&lt;b&gt;Any item marked Change?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="730" width="300" height="110" as="geometry"/></mxCell>
<mxCell id="gate" value="&lt;b&gt;Plan stops here&lt;/b&gt;&lt;br&gt;Without -Execute: print the table, write the report, stop. Nothing changed. With -Execute, and approval where a pipeline asks for it, the node is applied." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="420" height="96" as="geometry"/></mxCell>
<mxCell id="apply" value="&lt;b&gt;Apply (one call)&lt;/b&gt;&lt;br&gt;Send the Change items of every step except SBE, in step order. Each item reports changed, unchanged or failed. A failed item stops this pass for the node and the final comparison shows why.&lt;br&gt;Protected values (the local admin password) travel as protected parameters." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1015" width="420" height="120" as="geometry"/></mxCell>
<mxCell id="dec2" value="&lt;b&gt;Did an action ask for a restart?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="1175" width="300" height="110" as="geometry"/></mxCell>
<mxCell id="rst" value="&lt;b&gt;Restart once&lt;/b&gt;&lt;br&gt;One restart after all the changes (not with -NoRestart: the report then says which nodes need one). Wait for a new boot time, up to 30 minutes, then read again." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1325" width="420" height="100" as="geometry"/></mxCell>
<mxCell id="sbe" value="&lt;b&gt;Deliver the SBE package (last)&lt;/b&gt;&lt;br&gt;By hardware.sbe.delivery: winrm_copy, node_pull or skip. A file already tried once and still wrong is not sent again. A package that cannot be delivered is reported and never stops the other steps." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1465" width="420" height="120" as="geometry"/></mxCell>
<mxCell id="dec3" value="&lt;b&gt;Another pass? (limit: MaxPasses, 3)&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="1625" width="300" height="110" as="geometry"/></mxCell>
<mxCell id="final" value="&lt;b&gt;Final read and compare&lt;/b&gt;&lt;br&gt;Converged means nothing left to change and nothing Blocked. A step can wait for an earlier one (the OEM drivers wait for the SBE), which is why a node can need a second pass. A converged node got one read and no change script." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1790" width="420" height="110" as="geometry"/></mxCell>
<mxCell id="res" value="&lt;b&gt;Node result&lt;/b&gt;&lt;br&gt;Converged, restarted or not, with the changes made and the plan items left. A node that stays Blocked or not converged makes the run exit non-zero. Nothing about it stops the next node." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1935" width="420" height="110" as="geometry"/></mxCell>
<mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="read" target="cmp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="cmp" target="dec1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e11" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="dec1" target="gate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e12" value="gate: -Execute and approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="gate" target="apply"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="apply" target="dec2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e14" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="dec2" target="rst"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e15" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec2" target="sbe"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="476" y="1230"/><mxPoint x="476" y="1525"/></Array></mxGeometry></mxCell>
<mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="rst" target="sbe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="sbe" target="dec3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e18" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="dec3" target="final"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="final" target="res"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e20" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec1" target="final"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="785"/><mxPoint x="30" y="1845"/></Array></mxGeometry></mxCell>
<mxCell id="e21" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec3" target="read"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="508" y="1680"/><mxPoint x="508" y="490"/></Array></mxGeometry></mxCell>
<mxCell id="t22" value="The steps, in the order the script runs them" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="520" y="392" width="520" height="24" as="geometry"/></mxCell>
<mxCell id="st1" value="&lt;b&gt;1. RemoteManagement&lt;/b&gt;&lt;br&gt;WinRM running and Automatic with a listener; RDP allowed with its firewall group; ICMP echo rules on. Changed only if one is off." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="520" y="430" width="540" height="100" as="geometry"/></mxCell>
<mxCell id="st2" value="&lt;b&gt;2. Drivers&lt;/b&gt;&lt;br&gt;Needs the SBE on the node (hash matches). Each port is matched by PCI hardware ID to the OEM driver in the SBE; an older driver is replaced, a newer one is left alone, no match leaves the inbox driver. A driver may ask for a restart." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="520" y="548" width="540" height="100" as="geometry"/></mxCell>
<mxCell id="st3" value="&lt;b&gt;3. Network&lt;/b&gt;&lt;br&gt;Management port first, found by MAC. Mode A: verify only. Modes B and C: static address by MAC (DHCP off, address, gateway). Then every port with ip_assignment none: DHCP off, no address, no gateway. A second default gateway, or a management MAC no port has, is Blocked." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="520" y="666" width="540" height="100" as="geometry"/></mxCell>
<mxCell id="st4" value="&lt;b&gt;4. Dns&lt;/b&gt;&lt;br&gt;DNS servers on the management port (static modes). They cannot change after deployment." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="520" y="784" width="540" height="100" as="geometry"/></mxCell>
<mxCell id="st5" value="&lt;b&gt;5. Time&lt;/b&gt;&lt;br&gt;NTP peers equal networking.ntp_servers and the time type is NTP." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="520" y="902" width="540" height="100" as="geometry"/></mxCell>
<mxCell id="st6" value="&lt;b&gt;6. Hostname&lt;/b&gt;&lt;br&gt;The computer name equals the node name. A change needs a restart." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="520" y="1020" width="540" height="100" as="geometry"/></mxCell>
<mxCell id="st7" value="&lt;b&gt;7. UnusedAdapters&lt;/b&gt;&lt;br&gt;Ports the file marks unused are disabled." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="520" y="1138" width="540" height="100" as="geometry"/></mxCell>
<mxCell id="st8" value="&lt;b&gt;8. LocalAdmin&lt;/b&gt;&lt;br&gt;identity.local_admin exists as a local administrator, password from Key Vault. The built-in Administrator or Guest is Blocked." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="520" y="1256" width="540" height="100" as="geometry"/></mxCell>
<mxCell id="st9" value="&lt;b&gt;9. Mpio (SAN only)&lt;/b&gt;&lt;br&gt;MultipathIO feature (restart), the array's MSDSM hardware ID (restart before MPIO claims LUNs), load balance policy RR, MPIO timers. iSCSI: MSiSCSI service and MSDSM auto-claim only." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="520" y="1374" width="540" height="100" as="geometry"/></mxCell>
<mxCell id="st10" value="&lt;b&gt;10. SanVerify (SAN only, read only)&lt;/b&gt;&lt;br&gt;Every listed WWPN is seen; the infrastructure LUN (250 GB or more) and performance history LUN (20 GB or more) are visible, RAW, with two or more paths; every node sees the same disks. Blocked if not: zoning and masking are never done here." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="520" y="1492" width="540" height="100" as="geometry"/></mxCell>
<mxCell id="st11" value="&lt;b&gt;11. ClearStorage (only if os_configuration.clear_storage)&lt;/b&gt;&lt;br&gt;Leftover pools, virtual disks and data on non-boot local disks are wiped, never a SAN LUN, a USB disk or a boot disk. Without the switch, leftover storage is Blocked (S2D) or Info (SAN)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="520" y="1610" width="540" height="100" as="geometry"/></mxCell>
<mxCell id="st12" value="&lt;b&gt;12. Sbe (listed and delivered last)&lt;/b&gt;&lt;br&gt;The package files are in C:\SBE with matching SHA-256. How a missing file arrives is hardware.sbe.delivery. The drivers install in the pass after the package has landed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="520" y="1728" width="540" height="100" as="geometry"/></mxCell>
<mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="st1" target="st2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="st2" target="st3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="st3" target="st4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="st4" target="st5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="st5" target="st6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="st6" target="st7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="st7" target="st8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="st8" target="st9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="st9" target="st10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="st10" target="st11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="st11" target="st12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cmp" target="st1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="496" y="640"/><mxPoint x="496" y="480"/></Array></mxGeometry></mxCell>
<mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="st12" target="dec1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="488" y="1778"/><mxPoint x="488" y="785"/></Array></mxGeometry></mxCell>
<mxCell id="nt1" value="&lt;b&gt;What counts as a change&lt;/b&gt;&lt;br&gt;The node is read first. Each item is compared with the file: Ok (matches, nothing runs), Change (will be changed), Blocked (wrong, and this tool will not fix it), Info (reported only), Skipped (waits on an earlier step). Only Change items are applied. A re-run on a configured node reads once and runs no change script: it is idempotent." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="1110" y="430" width="450" height="150" as="geometry"/></mxCell>
<mxCell id="nt2" value="&lt;b&gt;Restart points&lt;/b&gt;&lt;br&gt;The computer name, the MPIO feature, a new MSDSM hardware ID and a driver that asks. They are collected into one restart per pass, after the changes. -NoRestart reports instead of restarting." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="1110" y="610" width="450" height="130" as="geometry"/></mxCell>
<mxCell id="nt3" value="&lt;b&gt;The three management address modes (Network step)&lt;/b&gt;&lt;br&gt;Found by MAC, whatever the OS calls the port (Port0 to Port6 after ZTP).&lt;br&gt;A, Reserved (dhcp_reservation): leave DHCP on, verify the reserved address. Info if it differs: check the reservation for the MAC.&lt;br&gt;B, Static with DHCP: ZTP's address was reset to DHCP by the OS install. Set the static by MAC.&lt;br&gt;C, Static without management DHCP: the port has no address and Arc reaches the node over the provisioning port. Set the static by MAC first, before any other port loses DHCP.&lt;br&gt;dhcp and preconfigured: left alone." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="1110" y="770" width="450" height="260" as="geometry"/></mxCell>
<mxCell id="nt4" value="&lt;b&gt;SAN-only steps (green)&lt;/b&gt;&lt;br&gt;Mpio and SanVerify run for storage_architecture san. For hybrid the LUN checks are skipped (Microsoft: do not zone the HBAs until after deployment); MPIO and MSDSM are still prepared. FC zoning, LUN masking and iSCSI targets are not automated." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="1110" y="1060" width="450" height="150" as="geometry"/></mxCell>
<mxCell id="nt5" value="&lt;b&gt;The SBE route (hardware.sbe.delivery)&lt;/b&gt;&lt;br&gt;Arc Run Command cannot carry a file.&lt;br&gt;winrm_copy: copied over WinRM from the operator host to a .part file, SHA-256 checked on the node, then renamed. Needs TCP 5985 and the local admin credential.&lt;br&gt;node_pull: the node downloads from hardware.sbe.node_pull_url (an address the nodes reach) and checks the SHA-256.&lt;br&gt;skip (default): reported as NOT DELIVERED, nothing else stops and no OEM driver is installed." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=6;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="1110" y="1240" width="450" height="210" as="geometry"/></mxCell>
<mxCell id="nt6" value="&lt;b&gt;Retry on Arc Run Command state Unknown&lt;/b&gt;&lt;br&gt;A Run Command can report state Unknown while the Connected Machine agent is busy, restarting or reconnecting. The call is read again and retried before the node is given up on; the node's error is then reported and the run goes on to the next node." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=6;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="1110" y="1480" width="450" height="130" as="geometry"/></mxCell>
<mxCell id="nt7" value="&lt;b&gt;Per-node continue on failure&lt;/b&gt;&lt;br&gt;A node that is unreachable, Blocked or not converged is reported with its step and reason. The other nodes still run to the end. The exit code is non-zero if any node is not ready." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=6;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="1110" y="1640" width="450" height="130" as="geometry"/></mxCell>
<mxCell id="rep" value="&lt;b&gt;Run summary and report&lt;/b&gt;&lt;br&gt;Every node must see the same SAN disks (UniqueIds). The JSON report (no secrets) lists the changes, the plan, ports by MAC with their OS names and the SAN disks. The ARM parameter generator reads it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="520" y="2130" width="540" height="100" as="geometry"/></mxCell>
<mxCell id="exit" value="&lt;b&gt;Exit code&lt;/b&gt;&lt;br&gt;0: every node matches the file (or the plan shows the changes to make). Non-zero: a Blocked item, a node not converged, or a SAN problem. Run again after fixing it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1110" y="2130" width="450" height="100" as="geometry"/></mxCell>
<mxCell id="arm" value="&lt;b&gt;Next: ARM Validate, then ARM Deploy&lt;/b&gt;&lt;br&gt;New-AzureLocalArmParameters reads the report. Validate never deploys; Deploy is a separate run." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="520" y="2260" width="540" height="80" as="geometry"/></mxCell>
<mxCell id="e36" value="all nodes done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="res" target="rep"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="2180"/></Array></mxGeometry></mxCell>
<mxCell id="e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="rep" target="arm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" parent="1" source="rep" target="exit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
</root></mxGraphModel></diagram></mxfile>
